# GardenForge server settings.
#
# STATUS: NOT YET EXECUTED - verify on first install.
#
# install.sh copies this file to /etc/gardenforge/pocketbase.env (mode 0640, root:gardenforge)
# the first time it runs and never overwrites it afterwards. The PocketBase service reads it
# through systemd's EnvironmentFile=, and backup.sh reads it too.
# Format: KEY=value, one per line, no spaces around "=", no quotes. Nothing in this file is secret.

# Address PocketBase listens on. Keep it on 127.0.0.1: only the tunnel (cloudflared or
# Tailscale, running on this same machine) should reach it. Never 0.0.0.0 on a public network.
PB_HTTP=127.0.0.1:8090

# Browser origins allowed to call the API (CORS), comma-separated, exact scheme+host, no
# trailing slash. Put the address the GardenForge app is served from, e.g. your Vercel site.
# The placeholder below blocks every browser until you change it.
PB_ORIGINS=https://REPLACE-WITH-YOUR-GARDENFORGE-SITE.vercel.app

# Where backup.sh keeps finished backups. Use a DIFFERENT disk from this machine's system disk
# (a USB drive, a NAS mount), and copy it somewhere else regularly: a backup on the same disk
# does not survive that disk failing. backup.sh refuses a directory inside pb_data.
BACKUP_DIR=/srv/gardenforge-backups

# Backups older than this many days are deleted from BACKUP_DIR by backup.sh.
BACKUP_KEEP_DAYS=30

# ------------------------------------------------------------------------------------------------
# The superuser token for backup.sh does NOT go here. It goes in /etc/gardenforge/backup.env,
# owned by root with mode 0600, containing exactly one line:
#
#   PB_BACKUP_TOKEN=<a _superusers impersonate token, see server/README.md "Backups">
#
# backup.sh refuses to run if that file is readable by anyone but root.
